{
  "name": "streaming-app",
  "version": "0.1.0",
  "private": true,
  "description": "A simpler live streaming and recording app, like OBS, for ATEM shows. Runs as a local web app with a tablet remote and a network control API.",
  "license": "GPL-2.0-or-later",
  "type": "commonjs",
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "tsx src/server/index.ts",
    "build": "vite build",
    "practice": "tsx scripts/dev-server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
